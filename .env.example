# OrbitMc - Backend Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Set this in Supabase Authentication > URL Configuration as the Site URL
# and add it to the Redirect URLs allowlist.
VITE_SUPABASE_REDIRECT_URL=https://orbitmc.vercel.app

# Supabase Auth (OAuth providers to enable)
VITE_SUPABASE_GOOGLE_CLIENT_ID=your-google-client-id
# Configure the OAuth client secret in Supabase; never expose it in a VITE_ variable.

# Supabase Storage (for images and attachments)
VITE_SUPABASE_STORAGE_BUCKET=uploads

# App Configuration
VITE_APP_NAME=OrbitMc
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=https://your-supabase-project.supabase.co

# Feature Flags
VITE_ENABLE_AURA_PAYMENTS=false
VITE_ENABLE_HUB_MODERATION=false
VITE_ENABLE_BAZAAR_PURCHASES=false

# For Electron main process
ELECTRON_SUPABASE_URL=https://your-project.supabase.co
ELECTRON_SUPABASE_ANON_KEY=your-anon-key-here
