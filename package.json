{
  "name": "orbitmc-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "OrbitMc - chats, hubs and Orbit Shop",
  "main": "electron/main.cjs",
  "author": "OrbitMc",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/domain.test.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder",
    "release": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "glob": {
      "minimatch": "3.1.5"
    },
    "dir-compare": {
      "minimatch": "3.1.5"
    },
    "filelist": {
      "minimatch": "5.1.9"
    }
  },
  "build": {
    "appId": "com.orbitmc.app",
    "productName": "OrbitMc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/orbitmc.ico",
      "artifactName": "${productName}-Windows-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Social"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "LICENSE"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
