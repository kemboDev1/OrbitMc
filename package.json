{
  "name": "orbitmc-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "OrbitMc - chats, hubs and Orbit Shop",
  "main": "electron/main.cjs",
  "author": "OrbitMc",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/domain.test.ts",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build && electron-builder",
    "release": "electron-builder"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "tsx": "^4.22.4"
  },
  "build": {
    "appId": "com.orbitmc.app",
    "productName": "OrbitMc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Windows-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Social"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "MIT"
    }
  }
}
